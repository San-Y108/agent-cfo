# Demo mode: "mock" = 不调用真实后端（当前默认）；切 "real" 才会使用下面的 API base URL
NEXT_PUBLIC_DEMO_MODE=mock

# 后端 FastAPI 地址（联调用）。本地 uvicorn 默认端口 8000。
# TODO(契约对齐): 当前 lib/api/* 端点与后端 /api/{payment-plan,risk-check,execute-payment,audit-report}
#   尚未对齐，切换 NEXT_PUBLIC_DEMO_MODE=real 前必须先重写 adapter 对齐契约，否则请求会失败。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
